DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Opcional: registra comandos solo en este servidor durante desarrollo.
DISCORD_DEV_GUILD_ID=
DATABASE_PATH=./data/bot.sqlite
# Economía: sqlite por defecto; usa mysql para persistencia remota en Pterodactyl.
# Si ya existen saldos en SQLite, migra antes de cambiar a mysql. Ver HOSTING.md.
ECONOMY_DB_DRIVER=sqlite
ECONOMY_DB_ENDPOINT=
ECONOMY_DB_HOST=
ECONOMY_DB_PORT=3306
ECONOMY_DB_USER=
ECONOMY_DB_PASSWORD=
ECONOMY_DB_NAME=
# Deja LAVALINK_PASSWORD vacío si no usarás música en esta instalación.
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
LAVALINK_SECURE=false
# Spotify Developer Dashboard credentials for LavaSrc on the Lavalink node.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
