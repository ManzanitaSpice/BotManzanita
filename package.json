{
  "name": "bot-manzanita",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Bot multiusos de Discord con paneles de música y economía.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "commands:deploy": "tsx src/deploy-commands.ts",
    "commands:deploy:built": "node dist/deploy-commands.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "discord.js": "14.28.0",
    "dotenv": "^16.6.1",
    "lavalink-client": "^2.11.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
